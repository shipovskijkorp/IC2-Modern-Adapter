{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Clean-room modern compatibility layer for IndustrialCraft 2 Experimental.",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "mixins": [
    {
      "config": "ic2_modern_adapter.fabric.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "main": [
      "com.shipovskijkorp.ic2modernadapter.IC2ModernAdapter"
    ],
    "client": [
      "com.shipovskijkorp.ic2modernadapter.client.IC2ModernAdapterClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
